# ─────────────────────────────────────────────────────────────────────────────
# REXAM MOBILE & WEB APPLICATION CONFIGURATION
# Copy this file to .env and fill in your Supabase project credentials.
# Never commit the actual .env file — it is in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase Project URL (from Supabase Dashboard → Project Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon / Publishable Key (safe to include in client-side code)
# This is NOT the service_role key — never use the service role key here.
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# ─── Android OAuth Redirect ───────────────────────────────────────────────────
# Deep-link scheme for Android Google OAuth callback (do not change format)
ANDROID_OAUTH_REDIRECT_URL=io.supabase.rexam://login-callback

# ─── Web OAuth Redirect ───────────────────────────────────────────────────────
# HTTPS redirect URL for web Google OAuth callback.
# This URL must also be added to Supabase Dashboard:
#   Authentication → URL Configuration → Redirect URLs
#
# Local development:
WEB_OAUTH_REDIRECT_URL=http://localhost:8080/auth/callback
#
# Production (replace with your actual Cloudflare Pages domain):
# WEB_OAUTH_REDIRECT_URL=https://rexam.pages.dev/auth/callback
# WEB_OAUTH_REDIRECT_URL=https://your-custom-domain.com/auth/callback
